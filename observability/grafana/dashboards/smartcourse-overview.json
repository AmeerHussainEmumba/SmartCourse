            "uid": "prometheus"
          },
          "expr": "sum(rate(workflow_failed_total[5m]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "DB connections in use vs max",
