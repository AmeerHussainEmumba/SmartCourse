{
  "uid": "smartcourse-overview",
  "title": "SmartCourse Overview",
  "tags": [
    "smartcourse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "RED rate. The label is the route template, never a raw path or id. Source: identity-api, course-api and analytics-api (on their API port); the worker has no HTTP API metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (5xx) by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request duration p50/p95/p99",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 duration by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox backlog (unpublished rows)",
      "description": "Rows not yet published. One table read by three binaries, so max() across jobs. Source: identity-api, course-api and worker (outbox gauges, refreshed every 15s).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(outbox_backlog)",
          "legendFormat": "backlog"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Outbox oldest unpublished age",
      "description": "Age of the oldest unpublished row, 0 when empty. A row the relay gave up on stays unpublished and keeps this high until it is handled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(outbox_oldest_unpublished_seconds)",
          "legendFormat": "oldest"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "description": "NO DATA until the Kafka consumers fill kafka_consumer_lag: the metric is defined, nothing feeds it yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kafka_consumer_lag",
          "legendFormat": "{{group}} / {{topic}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Asynq queue depth and retries",
      "description": "Source: worker (Asynq Inspector, every 15s). Depth = pending + scheduled (not yet started); retry = tasks waiting for their next attempt. Running and archived tasks are in neither.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asynq_queue_depth",
          "legendFormat": "depth {{queue}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "asynq_retry_count",
          "legendFormat": "retry {{queue}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Dead-letter rate by consumer",
      "description": "NO DATA until the Kafka transport parks events: dead_letter_total has no series before the first dead letter. Alert: DeadLetterRateHigh.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (consumer) (rate(dead_letter_total[5m]))",
          "legendFormat": "{{consumer}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Events processed by consumer and outcome",
      "description": "NO DATA until the Kafka consumers record outcomes (event_processed_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (consumer, outcome) (rate(event_processed_total[5m]))",
          "legendFormat": "{{consumer}} {{outcome}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Workflows started / completed / failed (rate)",
      "description": "Source: worker. Counts runs first executed live on a worker process; replays after a restart are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(workflow_started_total[5m]))",
          "legendFormat": "started"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(workflow_completed_total[5m]))",
          "legendFormat": "completed"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(workflow_failed_total[5m]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "DB connections in use vs max",
      "description": "Source: every service (db.Stats read at scrape time). db_connections_max is 0 for an unlimited pool.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "db_connections_in_use",
          "legendFormat": "in use {{job}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "db_connections_max",
          "legendFormat": "max {{job}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Scrape targets up (1 = scraped)",
      "description": "Prometheus up per job: identity-api, course-api, analytics-api, worker. Alert: ScrapeTargetDown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=~\"identity-api|course-api|analytics-api|worker\"}",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
