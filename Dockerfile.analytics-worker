# The analytics-worker image (docs/plans/microservices-split.md): the analytics
# Kafka consumers, the reconciler job and processed_events pruning. No public
# port; /metrics and health on the internal listener :9100.
# Both analytics binaries build from the one services/analytics module, so both
# images copy the same module set: the COPY list must equal the module's go.mod
# `replace` directives (scripts/check-dockerfile-modules.sh). GOWORK=off below
# means a missing module fails this build instead of being papered over by
# go.work. What each binary actually links is budgeted per binary in
# scripts/check-link-graph.sh (analytics-api links no Kafka, Asynq or Temporal).
# Build context is the repo root: docker build -f Dockerfile.analytics-worker .
FROM golang:1.26.11-alpine AS build
ENV GOWORK=off CGO_ENABLED=0
WORKDIR /src
COPY libs/asynqx ./libs/asynqx
COPY libs/auth ./libs/auth
COPY libs/cache ./libs/cache
COPY libs/config ./libs/config
COPY libs/db ./libs/db
COPY libs/errors ./libs/errors
COPY libs/eventbus ./libs/eventbus
COPY libs/events ./libs/events
COPY libs/httpx ./libs/httpx
COPY libs/idempotency ./libs/idempotency
COPY libs/infra ./libs/infra
COPY libs/jobs ./libs/jobs
COPY libs/kafka ./libs/kafka
COPY libs/logging ./libs/logging
COPY libs/mongostore ./libs/mongostore
COPY libs/outbox ./libs/outbox
COPY libs/relay ./libs/relay
COPY libs/router ./libs/router
COPY libs/runtime ./libs/runtime
COPY libs/telemetry ./libs/telemetry
COPY libs/testenv ./libs/testenv
COPY services/analytics ./services/analytics
WORKDIR /src/services/analytics
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -o /out/analytics-worker ./cmd/analytics-worker

FROM alpine:3.20
# Run as an unprivileged user: a compromise of the service should not be root in the container.
RUN apk add --no-cache ca-certificates && adduser -D -H -u 10001 app
USER app
COPY --from=build /out/analytics-worker /usr/local/bin/analytics-worker
EXPOSE 9100
ENTRYPOINT ["/usr/local/bin/analytics-worker"]
