# Copy to .env and fill in. No variable here has a working default baked
# into the application (RFC §11.8) — a missing value fails startup instead
# of silently falling back to something insecure.
#
# HOW THIS FILE IS ORGANISED
#   1. Shared settings, read by every binary.
#   2. One section per binary: exactly the variables it needs, REQUIRED and
#      OPTIONAL. A binary asks libs/config only for the groups it needs
#      (config.LoadWith) and starts WITHOUT the variables of the others: a
#      publishing-worker needs no Postgres, an analytics-api needs no Kafka.
#      A missing required variable stops that binary at startup and names it.
#   3. The variable reference, by group, with defaults and the rules Load checks.
#
# The values below are LOCAL-DEV defaults for the docker compose host ports and
# are marked [DEV ONLY] where they must change anywhere else. One .env serves
# every binary you run natively (`make run-*` includes it); for several binaries
# at once, give each its own POSTGRES_DSN and POSTGRES_SEARCH_PATH (section 2).
# Kafka is the only event transport: there is no EVENT_TRANSPORT switch and no
# in-process mode.

# ---------------------------------------------------------------------------
# 1. SHARED (every binary)
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
# Internal listener of EVERY binary: /metrics, /health/live, /health/ready
# (host:port, default :9100). Never the public port; /metrics has no
# authentication by design, keep it on a private network. When binaries share a
# host, give each its own port. docker-compose.yml publishes the containers'
# :9100 as identity-api 9101, course-api 9102, analytics-api 9103, audit-api
# 9104, identity-worker 9111, course-worker 9112, analytics-worker 9113,
# notification-worker 9114, publishing-worker 9115, audit-worker 9116 (host
# side, 127.0.0.1); using the same numbers natively is a good convention, but
# the application does not fix them.
METRICS_HTTP_ADDR=:9100
# METRICS_ENABLED=true
# Observability (ADR-0032). Telemetry never blocks or fails startup.
# Tracing: OTLP over HTTP (Jaeger's port 4318), as host:port or an http(s) URL.
# Unset (the default) means tracing is off; set but unreachable means spans are
# dropped and a warning is logged. Inside compose use jaeger:4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# Standard switch: true turns tracing off even when an endpoint is set.
# OTEL_SDK_DISABLED=false
# service.name; each binary defaults to its own name (course-api, ...).
# OTEL_SERVICE_NAME=
# Head-sampling ratio, 0.0 to 1.0 (1.0 = sample everything, the dev default).
# OTEL_TRACES_SAMPLER_ARG=1.0

# ---------------------------------------------------------------------------
# 2. PER BINARY
# ---------------------------------------------------------------------------
# Every binary below that needs Postgres sets POSTGRES_DSN to its OWN service
# role and POSTGRES_SEARCH_PATH to `<schema>,public` (ADR-0024). The roles are
# created by scripts/db-roles.sh (`make migrate-up`, `make db-roles`).
#
#   service       role              POSTGRES_SEARCH_PATH   DSN variable below
#   identity      svc_identity      identity,public        IDENTITY_POSTGRES_DSN
#   course        svc_course        course,public          COURSE_POSTGRES_DSN
#   analytics     svc_analytics     analytics,public       ANALYTICS_POSTGRES_DSN
#   notification  svc_notification  notification,public    NOTIFICATION_POSTGRES_DSN
#
# The application reads only POSTGRES_DSN; the four variables below are a
# convenience for your shell or compose file: `POSTGRES_DSN="$IDENTITY_POSTGRES_DSN"`.
# Same host, port and database as the owner DSN, different login; keep the
# passwords equal to the SVC_*_PASSWORD values in section 3.
# [DEV ONLY] passwords.
IDENTITY_POSTGRES_DSN=postgres://svc_identity:svc_identity_dev@localhost:5433/smartcourse?sslmode=disable
COURSE_POSTGRES_DSN=postgres://svc_course:svc_course_dev@localhost:5433/smartcourse?sslmode=disable
ANALYTICS_POSTGRES_DSN=postgres://svc_analytics:svc_analytics_dev@localhost:5433/smartcourse?sslmode=disable
NOTIFICATION_POSTGRES_DSN=postgres://svc_notification:svc_notification_dev@localhost:5433/smartcourse?sslmode=disable
#
# --- identity-api -----------------------------------------------------------
#   Groups:   Postgres, Redis, JWT, Argon
#   REQUIRED: POSTGRES_DSN (svc_identity), POSTGRES_SEARCH_PATH=identity,public,
#             REDIS_ADDR, JWT_SIGNING_KEY
#   OPTIONAL: HTTP_PORT, JWT_ACCESS_TTL, JWT_REFRESH_TTL, JWT_ISSUER, ARGON2_*,
#             CORS_ALLOWED_ORIGINS, the HTTP hardening settings, POSTGRES_MAX_*,
#             REDIS_PASSWORD, REDIS_DB, METRICS_HTTP_ADDR, OTEL_*
#   Not read: Kafka, Schema Registry, MinIO, MongoDB, SMTP.
#
# --- identity-worker --------------------------------------------------------
#   Groups:   Postgres, Redis, Kafka
#   REQUIRED: POSTGRES_DSN (svc_identity), POSTGRES_SEARCH_PATH=identity,public,
#             REDIS_ADDR, KAFKA_BROKERS, SCHEMA_REGISTRY_URL
#   OPTIONAL: RELAY_WORKERS, KAFKA_* tuning, ASYNQ_*, OUTBOX_RETENTION,
#             JOBS_OUTBOX_PRUNE_INTERVAL, POSTGRES_MAX_*, REDIS_PASSWORD,
#             REDIS_DB, METRICS_HTTP_ADDR, OTEL_*
#   Not read: JWT, MinIO, MongoDB, SMTP.
#
# --- identity-admin (CLI: creates the first admin) --------------------------
#   Groups:   Postgres, Redis, Argon (it hashes the password; it signs no token,
#             so JWT_SIGNING_KEY is NOT needed)
#   REQUIRED: POSTGRES_DSN (svc_identity), POSTGRES_SEARCH_PATH=identity,public,
#             REDIS_ADDR, IDENTITY_ADMIN_EMAIL, IDENTITY_ADMIN_PASSWORD
#   OPTIONAL: IDENTITY_ADMIN_NAME, ARGON2_*, REDIS_PASSWORD, REDIS_DB
#
# --- course-api -------------------------------------------------------------
#   Groups:   Postgres, Redis, MinIO, JWT
#   REQUIRED: POSTGRES_DSN (svc_course), POSTGRES_SEARCH_PATH=course,public,
#             REDIS_ADDR, MINIO_ENDPOINT, MINIO_ACCESS_KEY_ID,
#             MINIO_SECRET_ACCESS_KEY, JWT_SIGNING_KEY
#   OPTIONAL: HTTP_PORT, MINIO_USE_SSL, MINIO_BUCKET_ASSETS,
#             MINIO_PUBLIC_ENDPOINT, TEMPORAL_* (dialled lazily, never blocks
#             boot), JWT_ISSUER and TTLs, CORS_ALLOWED_ORIGINS, the HTTP
#             hardening settings, POSTGRES_MAX_*, REDIS_*, METRICS_HTTP_ADDR, OTEL_*
#   Not read: Kafka (course-worker relays the outbox), Argon, MongoDB.
#
# --- course-worker ----------------------------------------------------------
#   Groups:   Postgres, Redis, MinIO, Kafka
#   REQUIRED: POSTGRES_DSN (svc_course), POSTGRES_SEARCH_PATH=course,public,
#             REDIS_ADDR, MINIO_ENDPOINT, MINIO_ACCESS_KEY_ID,
#             MINIO_SECRET_ACCESS_KEY, KAFKA_BROKERS, SCHEMA_REGISTRY_URL
#   OPTIONAL: MONGO_URI (+ MONGO_*: dead-letter parking), TEMPORAL_*,
#             RELAY_WORKERS, KAFKA_* tuning, ASYNQ_*, OUTBOX_RETENTION,
#             PROCESSED_EVENTS_RETENTION, JOBS_RECONCILE_PUBLISHES_INTERVAL,
#             JOBS_ENROLLMENT_COUNT_INTERVAL, JOBS_IDEMPOTENCY_PRUNE_INTERVAL,
#             JOBS_OUTBOX_PRUNE_INTERVAL, MINIO_*, POSTGRES_MAX_*, REDIS_*
#   Not read: JWT, Argon, SMTP.
#
# --- analytics-api ----------------------------------------------------------
#   Groups:   Postgres, Redis, JWT
#   REQUIRED: POSTGRES_DSN (svc_analytics), POSTGRES_SEARCH_PATH=analytics,public,
#             REDIS_ADDR, JWT_SIGNING_KEY
#   OPTIONAL: HTTP_PORT, MONGO_URI (+ MONGO_*: the failed-events metric answers
#             503 without it), JWT_ISSUER, CORS_ALLOWED_ORIGINS, the HTTP
#             hardening settings, POSTGRES_MAX_*, REDIS_*, METRICS_HTTP_ADDR, OTEL_*
#   Not read: Kafka, MinIO, Argon.
#
# --- analytics-worker -------------------------------------------------------
#   Groups:   Postgres, Redis, Kafka
#   REQUIRED: POSTGRES_DSN (svc_analytics), POSTGRES_SEARCH_PATH=analytics,public,
#             REDIS_ADDR, KAFKA_BROKERS, SCHEMA_REGISTRY_URL
#   OPTIONAL: MONGO_URI (+ MONGO_*: dead-letter parking), KAFKA_* tuning,
#             ASYNQ_*, JOBS_ANALYTICS_RECONCILE_INTERVAL,
#             PROCESSED_EVENTS_RETENTION, POSTGRES_MAX_*, REDIS_*
#   Not read: JWT, MinIO, Argon.
#
# --- notification-worker ----------------------------------------------------
#   Groups:   Postgres, Redis, Kafka
#   REQUIRED: POSTGRES_DSN (svc_notification), POSTGRES_SEARCH_PATH=notification,public,
#             REDIS_ADDR, KAFKA_BROKERS, SCHEMA_REGISTRY_URL
#   OPTIONAL: SMTP_* (delivery is off without SMTP_HOST), MONGO_URI (+ MONGO_*:
#             dead-letter parking), KAFKA_* tuning, ASYNQ_*,
#             JOBS_OUTBOX_PRUNE_INTERVAL, PROCESSED_EVENTS_RETENTION,
#             POSTGRES_MAX_*, REDIS_*
#   Not read: JWT, MinIO, Argon.
#
# --- publishing-worker ------------------------------------------------------
#   Groups:   none (no Postgres, Redis or Kafka)
#   REQUIRED: nothing
#   OPTIONAL: TEMPORAL_HOST_PORT, TEMPORAL_NAMESPACE, TEMPORAL_TASK_QUEUE,
#             METRICS_HTTP_ADDR, OTEL_*
#
# --- audit-api, audit-worker ------------------------------------------------
#   Both need no Postgres, no MinIO and no Schema Registry (services/audit/README.md).
#   audit-api groups:    Redis, JWT, Kafka brokers, MongoDB
#   audit-api REQUIRED:  REDIS_ADDR, JWT_SIGNING_KEY, KAFKA_BROKERS, MONGO_URI
#   audit-api OPTIONAL:  HTTP_PORT, JWT_ISSUER, the HTTP hardening settings,
#                        MONGO_*, REDIS_PASSWORD, REDIS_DB, METRICS_HTTP_ADDR, OTEL_*
#   audit-worker groups: Kafka brokers, MongoDB
#   audit-worker REQUIRED: KAFKA_BROKERS, MONGO_URI
#   audit-worker OPTIONAL: KAFKA_* tuning, MONGO_*, METRICS_HTTP_ADDR, OTEL_*

# ---------------------------------------------------------------------------
# 3. VARIABLE REFERENCE (defaults shown; Load rejects out-of-range values)
# ---------------------------------------------------------------------------

# --- Postgres ---------------------------------------------------------------
# docker compose --profile core exposes Postgres on localhost:5433 (not the
# 5432 default — kept clear of other local projects' containers).
# POSTGRES_DSN below is the OWNER connection: migrations, `make migrate-up`,
# scripts/db-roles.sh and the seed tool use it. Binaries use their own service
# role (section 2). [DEV ONLY] credentials.
POSTGRES_DSN=postgres://smartcourse:smartcourse@localhost:5433/smartcourse?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=10
# Differs per binary (section 2): the schema(s) bare table names resolve to.
POSTGRES_SEARCH_PATH=identity,public
# Per-service role passwords (scripts/db-roles.sh; run by `make migrate-up`,
# `make db-roles` and the compose postgres init). [DEV ONLY]: change them
# anywhere that is not your own machine. The script refuses to run when one is
# unset, and nothing in git SQL carries a password.
SVC_IDENTITY_PASSWORD=svc_identity_dev
SVC_COURSE_PASSWORD=svc_course_dev
SVC_ANALYTICS_PASSWORD=svc_analytics_dev
SVC_NOTIFICATION_PASSWORD=svc_notification_dev
# Per-role CONNECTION LIMIT (script defaults shown): size each against its
# binaries' POSTGRES_MAX_OPEN_CONNS x replicas.
SVC_IDENTITY_CONN_LIMIT=30
SVC_COURSE_CONN_LIMIT=60
SVC_ANALYTICS_CONN_LIMIT=30
SVC_NOTIFICATION_CONN_LIMIT=30
# Relay pool (identity-worker, course-worker): each relay worker holds its claim
# connection while its handlers need another, so POSTGRES_MAX_OPEN_CONNS must be
# at least 2 x RELAY_WORKERS (checked at startup).
# RELAY_WORKERS=4

# --- Redis ------------------------------------------------------------------
# [DEV ONLY] host port of the compose redis.
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# --- MinIO (course-api, course-worker) --------------------------------------
# [DEV ONLY] credentials of the compose minio (image: the pgsty/minio fork, see ADR-0019).
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY_ID=smartcourse
MINIO_SECRET_ACCESS_KEY=smartcourse123
MINIO_USE_SSL=false
MINIO_BUCKET_ASSETS=smartcourse-assets
# Endpoint written into pre-signed URLs for browsers, when it differs from the
# one the service dials (inside compose: http://minio:9000 vs the host port).
# MINIO_PUBLIC_ENDPOINT=

# --- Kafka and Schema Registry (identity-worker, course-worker, analytics-worker,
#     notification-worker: REQUIRED there; audit-api and audit-worker need only
#     KAFKA_BROKERS, no registry; unread elsewhere) -----------------------------
# Seed brokers, comma-separated host:port. Host listener of the compose `kafka`
# service; inside the compose network use kafka:9092 instead.
KAFKA_BROKERS=localhost:29092
# Confluent Schema Registry (http or https URL).
SCHEMA_REGISTRY_URL=http://localhost:8081
# Consumer tuning (optional, defaults shown). Max in flight is per consumer group
# and each running handler holds a Postgres connection, so the worst case is
# groups x this value; the pool queues the excess. Attempts is tries per record
# before it is dead-lettered and the offset advances.
# KAFKA_CONSUMER_MAX_IN_FLIGHT=4
# A handler that depends on another consumer group (the certificate issuer needs
# the student name mirrored by a different group) must outlast that group lagging
# or starting, so the budget is about a minute: 0.5s doubling to 30s over 8 attempts.
# KAFKA_CONSUMER_MAX_ATTEMPTS=8
# KAFKA_CONSUMER_BACKOFF_BASE=500ms
# KAFKA_CONSUMER_BACKOFF_MAX=30s
# KAFKA_CONSUMER_SHUTDOWN_TIMEOUT=30s
# How long the relay rides out a broker outage inside one publish (max 25s: the
# relay gives a row 30s in all). An outage does not use up a row's retry budget.
# KAFKA_PRODUCE_TIMEOUT=20s
# Topic provisioning (docker-compose.yml kafka-init). Read by compose, not by
# the app; only applied when a topic is first created.
# KAFKA_TOPIC_PARTITIONS=3
# KAFKA_TOPIC_REPLICATION_FACTOR=1

# --- MongoDB (required by audit-api and audit-worker, optional elsewhere) ------------------
# Event archive, dead-letter parking and failed-event replay. The compose
# mongodb service runs without authentication, so no credentials in the URI.
# Unset: dead-letter parking is off and analytics-api's GET /analytics/issues
# answers 503. Set but unreachable: they degrade and retry; nothing else stops.
# The URI may carry credentials; it is never logged. Must start with mongodb://
# or mongodb+srv://.
# MONGO_URI=mongodb://localhost:27017
# MONGO_DATABASE=smartcourse
# MONGO_CONNECT_TIMEOUT=5s
# MONGO_SERVER_SELECTION_TIMEOUT=3s
# MONGO_OP_TIMEOUT=5s

# --- Temporal (course-api, course-worker, publishing-worker) -----------------
# M2 — course publish workflow, RFC §7/§21, ADR-0009/0025. All optional with
# working defaults; dialled lazily, so a missing or unreachable Temporal server
# never blocks boot, only publishing itself.
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE is the WORKFLOW queue (the publish workflow starts and runs
# here); the activities have their own queue, TEMPORAL_ACTIVITY_QUEUE
# (libs/contracts/publishing).
TEMPORAL_TASK_QUEUE=publish-workflows
TEMPORAL_ACTIVITY_QUEUE=course-activities

# --- Workers: Asynq pools, retry policy, scheduled jobs (ADR-0013, RFC §10.2) -
# One pool per queue; the pools whose handlers use Postgres, plus RELAY_WORKERS,
# must fit in POSTGRES_MAX_OPEN_CONNS (not checked at startup).
ASYNQ_CRITICAL_CONCURRENCY=10
ASYNQ_DEFAULT_CONCURRENCY=5
ASYNQ_LOW_CONCURRENCY=3
# Retries after the first attempt for scheduled jobs (0 to 25), then Asynq
# archives the task. Delay is BASE * 2^n capped at MAX, with 20% jitter.
ASYNQ_MAX_RETRY=5
ASYNQ_BACKOFF_BASE=2s
ASYNQ_BACKOFF_MAX=10m
ASYNQ_SHUTDOWN_TIMEOUT=30s
# Published outbox rows older than this are deleted (1h to 365d); unpublished
# rows never are. identity-worker, course-worker.
OUTBOX_RETENTION=168h
# course-worker, analytics-worker, notification-worker: processed_events markers
# older than this are deleted (a Go duration, default 336h = 14 days; zero,
# negative or unparsable stops the binary at startup). It is the
# duplicate-absorption window: keep it longer than the Kafka topic retention and
# than the longest wait before a parked event is replayed, or a late duplicate
# is applied twice.
PROCESSED_EVENTS_RETENTION=336h
# Scheduled job intervals: whole minutes that divide 60 (1m, 5m, 15m, 30m, ...)
# or whole hours that divide 24 (1h, 6h, 12h, 24h), so every replica agrees on
# the tick.
JOBS_RECONCILE_PUBLISHES_INTERVAL=1m
JOBS_ANALYTICS_RECONCILE_INTERVAL=1m
JOBS_ENROLLMENT_COUNT_INTERVAL=1h
JOBS_IDEMPOTENCY_PRUNE_INTERVAL=1h
JOBS_OUTBOX_PRUNE_INTERVAL=1h

# --- JWT (identity-api, course-api, analytics-api, audit-api) ---------------------------
# [DEV ONLY] placeholder. Generate a real key: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-real-random-secret-at-least-32-bytes-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=smartcourse
# Outside APP_ENV=development the service refuses to start with a placeholder
# or low-entropy JWT_SIGNING_KEY (including the one above), an out-of-range
# ARGON2_* value, or a non-positive token TTL.

# --- Argon2 (identity-api, identity-admin) -----------------------------------
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
# Max argon2 hashes running at once (1 to 1024). Peak hashing memory is about
# this x ARGON2_MEMORY_KIB, so it caps what a login flood can pin. Default is
# derived from the CPUs Go sees (GOMAXPROCS / ARGON2_PARALLELISM, clamped to
# 2..8; 4 on an 8-CPU host), which is safe, so it is left commented.
# Requests wait for a slot up to ARGON2_QUEUE_TIMEOUT (default 5s, max 1m) and
# then get 503 temporarily_unavailable; they are never counted as failed logins.
# ARGON2_MAX_CONCURRENT=4
# ARGON2_QUEUE_TIMEOUT=5s

# --- HTTP (identity-api, course-api, analytics-api, audit-api) --------------------------
HTTP_PORT=8080
# Comma-separated. Empty means no cross-origin requests are allowed
# (RFC §11.9 — deny-by-default). http://localhost:8089 is the local
# Swagger UI container (docker-compose.yml) — without it here, its
# "Execute" button gets a CORS rejection from the browser, not the API.
CORS_ALLOWED_ORIGINS=http://localhost:8089
# HTTP hardening (all optional; shown with their defaults).
# Request bodies larger than this get 413. Default 1 MiB.
# MAX_BODY_BYTES=1048576
# Server timeouts (Go duration strings). The publish endpoint returns 202
# immediately, so these do not constrain it.
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=120s
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For header
# is trusted. Default: none, so a spoofed header cannot change the client IP
# the rate limiter sees. Set this when running behind a load balancer, or
# every client will share the proxy's address.
# TRUSTED_PROXIES=10.0.0.0/8
# Send Strict-Transport-Security. Also sent automatically on TLS requests.
# HSTS_ENABLED=false

# --- SMTP (notification-worker, optional) ------------------------------------
# Mailpit SMTP sink for notification delivery. No real mail provider is used
# (Week 3 decision D6). Web UI/API: http://localhost:8025. Without SMTP_HOST,
# delivery is off.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# Envelope sender and From header; a bare address, no display name.
# SMTP_FROM=no-reply@smartcourse.local
# Mailpit needs no TLS and no credentials. For a server that does: STARTTLS is
# mandatory when enabled (never a cleartext fallback), and credentials are
# refused over a cleartext link unless SMTP_ALLOW_INSECURE_AUTH=true.
# SMTP_STARTTLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ALLOW_INSECURE_AUTH=false
# SMTP_CONNECT_TIMEOUT=5s
# SMTP_SEND_TIMEOUT=30s

# --- First admin (identity-admin) --------------------------------------------
# The HTTP API can only grant admin to an existing admin, so this CLI creates
# the first one. Idempotent; the password follows the registration rules (8 to
# 128 characters). [DEV ONLY] values: set a real secret outside local
# development and never commit it.
#   docker compose run --rm --entrypoint identity-admin -e IDENTITY_ADMIN_EMAIL -e IDENTITY_ADMIN_PASSWORD identity-api
# IDENTITY_ADMIN_EMAIL=admin@smartcourse.local
# IDENTITY_ADMIN_PASSWORD=change-me-admin-password
# IDENTITY_ADMIN_NAME=Administrator

# --- Seed tool (`make seed`, tools/seed) --------------------------------------
# `make seed` first creates the admin below with identity-admin inside the
# identity-api image (docker compose run), then runs tools/seed on the host as
# an HTTP client of the published ports: it touches no database. All optional:
# IDENTITY_URL=http://localhost:8090
# COURSE_URL=http://localhost:8091
# ANALYTICS_URL=http://localhost:8092
# SEED_ADMIN_EMAIL=admin@smartcourse.local
# SEED_ADMIN_PASSWORD=change-me-admin-password
