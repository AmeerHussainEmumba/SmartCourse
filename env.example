# Copy to .env and fill in. No variable here has a working default baked
# into the application (RFC §11.8) — a missing value fails startup instead
# of silently falling back to something insecure.

APP_ENV=development
LOG_LEVEL=info
HTTP_PORT=8080

# docker compose --profile core exposes Postgres on localhost:5433 (not the
# 5432 default — kept clear of other local projects' containers) with these
# credentials (docker-compose.yml).
POSTGRES_DSN=postgres://smartcourse:smartcourse@localhost:5433/smartcourse?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=10
# Schema-per-service (ADR-0024) — this is NOT one value for the whole app:
# each of the four binaries needs its own (identity-api needs
# "identity,platform,public", course-api needs "course,platform,public",
# analytics-api needs "analytics,public", worker needs
# "platform,course,analytics,public"). `make run-*` and docker-compose.yml
# already set the right one per binary — this line only matters if you run
# a cmd/* binary directly with `go run`, in which case set it yourself
# first. The value below is identity-api's, as a placeholder.
POSTGRES_SEARCH_PATH=identity,platform,public

REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY_ID=smartcourse
MINIO_SECRET_ACCESS_KEY=smartcourse123
MINIO_USE_SSL=false
MINIO_BUCKET_ASSETS=smartcourse-assets

# Temporal (M2 — course publish workflow, RFC §7/§21, ADR-0009/0025).
# All optional with working defaults: only course-api (starting a publish)
# and worker (running it) ever dial Temporal, and both do so lazily — a
# missing/unreachable Temporal server never blocks boot, only publishing
# itself. identity-api and analytics-api don't read these at all.
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=course-publish

# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-real-random-secret-at-least-32-bytes-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=smartcourse

ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# Comma-separated. Empty means no cross-origin requests are allowed
# (RFC §11.9 — deny-by-default). http://localhost:8089 is the local
# Swagger UI container (docker-compose.yml) — without it here, its
# "Execute" button gets a CORS rejection from the browser, not the API.
CORS_ALLOWED_ORIGINS=http://localhost:8089
