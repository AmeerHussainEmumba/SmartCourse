# Copy to .env and fill in. No variable here has a working default baked
# into the application (RFC §11.8) — a missing value fails startup instead
# of silently falling back to something insecure.

APP_ENV=development
LOG_LEVEL=info
HTTP_PORT=8080

# docker compose --profile core exposes Postgres on localhost:5433 (not the
# 5432 default — kept clear of other local projects' containers) with these
# credentials (docker-compose.yml).
POSTGRES_DSN=postgres://smartcourse:smartcourse@localhost:5433/smartcourse?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=10
# Schema-per-service (ADR-0024) — this is NOT one value for the whole app:
# each of the four binaries needs its own (identity-api needs
# "identity,platform,public", course-api needs "course,platform,public",
# analytics-api needs "analytics,public", worker needs
# "platform,course,analytics,public"). `make run-*` and docker-compose.yml
# already set the right one per binary — this line only matters if you run
# a cmd/* binary directly with `go run`, in which case set it yourself
# first. The value below is identity-api's, as a placeholder.
POSTGRES_SEARCH_PATH=identity,platform,public

REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY_ID=smartcourse
MINIO_SECRET_ACCESS_KEY=smartcourse123
MINIO_USE_SSL=false
MINIO_BUCKET_ASSETS=smartcourse-assets

# Temporal (M2 — course publish workflow, RFC §7/§21, ADR-0009/0025).
# All optional with working defaults: only course-api (starting a publish)
# and worker (running it) ever dial Temporal, and both do so lazily — a
# missing/unreachable Temporal server never blocks boot, only publishing
# itself. identity-api and analytics-api don't read these at all.
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=course-publish

# Worker only: Asynq pools, retry policy and scheduled jobs (ADR-0013, RFC
# §10.2). All optional with the defaults shown; Load rejects out-of-range values.
# One pool per queue; the pools whose handlers use Postgres, plus the relay's
# RELAY_WORKERS, must fit in POSTGRES_MAX_OPEN_CONNS (not checked at startup).
ASYNQ_CRITICAL_CONCURRENCY=10
ASYNQ_DEFAULT_CONCURRENCY=5
ASYNQ_LOW_CONCURRENCY=3
# Retries after the first attempt for scheduled jobs (0 to 25), then Asynq
# archives the task. Delay is BASE * 2^n capped at MAX, with 20% jitter.
ASYNQ_MAX_RETRY=5
ASYNQ_BACKOFF_BASE=2s
ASYNQ_BACKOFF_MAX=10m
ASYNQ_SHUTDOWN_TIMEOUT=30s
# Published outbox rows older than this are deleted (1h to 365d); unpublished
# rows never are.
OUTBOX_RETENTION=168h
# Scheduled job intervals: whole minutes that divide 60 (1m, 5m, 15m, 30m, ...)
# or whole hours that divide 24 (1h, 6h, 12h, 24h), so every replica agrees on
# the tick.
JOBS_RECONCILE_PUBLISHES_INTERVAL=1m
JOBS_ANALYTICS_RECONCILE_INTERVAL=1m
JOBS_ENROLLMENT_COUNT_INTERVAL=1h
JOBS_IDEMPOTENCY_PRUNE_INTERVAL=1h
JOBS_OUTBOX_PRUNE_INTERVAL=1h

# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-real-random-secret-at-least-32-bytes-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=smartcourse

ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
# Max argon2 hashes running at once (1 to 1024). Peak hashing memory is about
# this x ARGON2_MEMORY_KIB, so it caps what a login flood can pin. Default is
# derived from the CPUs Go sees (GOMAXPROCS / ARGON2_PARALLELISM, clamped to
# 2..8; 4 on an 8-CPU host), which is safe, so it is left commented.
# Requests wait for a slot up to ARGON2_QUEUE_TIMEOUT (default 5s, max 1m) and
# then get 503 temporarily_unavailable; they are never counted as failed logins.
# ARGON2_MAX_CONCURRENT=4
# ARGON2_QUEUE_TIMEOUT=5s

# Comma-separated. Empty means no cross-origin requests are allowed
# (RFC §11.9 — deny-by-default). http://localhost:8089 is the local
# Swagger UI container (docker-compose.yml) — without it here, its
# "Execute" button gets a CORS rejection from the browser, not the API.
CORS_ALLOWED_ORIGINS=http://localhost:8089

# HTTP hardening (all optional; shown with their defaults).
# Request bodies larger than this get 413. Default 1 MiB.
# MAX_BODY_BYTES=1048576
# Server timeouts (Go duration strings). The publish endpoint returns 202
# immediately, so these do not constrain it.
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=120s
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For header
# is trusted. Default: none, so a spoofed header cannot change the client IP
# the rate limiter sees. Set this when running behind a load balancer, or
# every client will share the proxy's address.
# TRUSTED_PROXIES=10.0.0.0/8
# Send Strict-Transport-Security. Also sent automatically on TLS requests.
# HSTS_ENABLED=false

# Outside APP_ENV=development the service refuses to start with a placeholder
# or low-entropy JWT_SIGNING_KEY (including the one above), an out-of-range
# ARGON2_* value, or a non-positive token TTL. Generate a real key:
#   openssl rand -base64 48

# ---------------------------------------------------------------------------
# Week 3 (events, workers, analytics, observability) — DOCUMENTATION ONLY.
# Everything below is commented out and has NO effect until the phase that
# reads it lands (libs/events, libs/mongostore, libs/asynqx, libs/telemetry).
# Exception: the event transport block (EVENT_TRANSPORT ... KAFKA_PRODUCE_TIMEOUT,
# SCHEMA_REGISTRY_URL) is read today (ADR-0029), commented out only because the
# default needs none of it.
# Values are local-dev placeholders for the compose `events` and
# `observability` profiles (host-side ports); no credentials are involved.
# ---------------------------------------------------------------------------
# Event transport (ADR-0029, read by Load in every binary; only the worker acts
# on it). inprocess = the relay runs the handlers itself (default). kafka = the
# relay publishes to Kafka and a consumer group per consumer name runs the same
# handlers; needs KAFKA_BROKERS and SCHEMA_REGISTRY_URL, and the schemas must
# already be registered (go run ./cmd/register-schemas in libs/events). Any
# other value fails startup.
# EVENT_TRANSPORT=inprocess
# Kafka seed brokers, comma-separated host:port; required when
# EVENT_TRANSPORT=kafka. Host listener of the compose `kafka` service; inside the
# compose network use kafka:9092 instead.
# KAFKA_BROKERS=localhost:29092
# Consumer tuning (kafka mode). Max in flight is per consumer group and each
# running handler holds a Postgres connection, so the worst case is groups x this
# value; the pool queues the excess. Attempts is tries per record before it is
# dead-lettered and the offset advances.
# KAFKA_CONSUMER_MAX_IN_FLIGHT=4
# A handler that depends on another consumer group (the certificate issuer needs the
# student name mirrored by a different group) must outlast that group lagging or
# starting, so the budget is about a minute: 0.5s doubling to 30s over 8 attempts.
# KAFKA_CONSUMER_MAX_ATTEMPTS=8
# KAFKA_CONSUMER_BACKOFF_BASE=500ms
# KAFKA_CONSUMER_BACKOFF_MAX=30s
# KAFKA_CONSUMER_SHUTDOWN_TIMEOUT=30s
# How long the relay rides out a broker outage inside one publish (max 25s: the
# relay gives a row 30s in all). An outage does not use up a row's retry budget.
# KAFKA_PRODUCE_TIMEOUT=20s
# Topic provisioning (docker-compose.yml kafka-init). Read by compose, not by
# the app; only applied when a topic is first created.
# KAFKA_TOPIC_PARTITIONS=3
# KAFKA_TOPIC_REPLICATION_FACTOR=1
# Confluent Schema Registry; required when EVENT_TRANSPORT=kafka.
# SCHEMA_REGISTRY_URL=http://localhost:8081
# MongoDB, audit archive and failed_events (Phase 3). The compose mongodb
# service runs without authentication, so no credentials in the URI.
# MONGO_URI=mongodb://localhost:27017
# MongoDB is optional. Unset: the worker's audit archive, dead-letter parking
# and failed-event replay are off and analytics-api's GET /analytics/issues
# answers 503. Set but unreachable: they degrade and retry; nothing else stops.
# The URI may carry credentials; it is never logged. Must start with
# mongodb:// or mongodb+srv://.
# MONGO_DATABASE=smartcourse
# MONGO_CONNECT_TIMEOUT=5s
# MONGO_SERVER_SELECTION_TIMEOUT=3s
# MONGO_OP_TIMEOUT=5s
# Worker admin surface (GET /health/*, failed-event list and replay under
# /api/v1/admin/failed-events; admin JWT required). host:port, default :8093.
# Compose publishes it on 127.0.0.1 only.
# ADMIN_HTTP_ADDR=:8093
# Mailpit SMTP sink for notification delivery (Phase 3). No real mail
# provider is used (Week 3 decision D6). Web UI/API: http://localhost:8025.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# Envelope sender and From header; a bare address, no display name.
# SMTP_FROM=no-reply@smartcourse.local
# Mailpit needs no TLS and no credentials. For a server that does: STARTTLS is
# mandatory when enabled (never a cleartext fallback), and credentials are
# refused over a cleartext link unless SMTP_ALLOW_INSECURE_AUTH=true.
# SMTP_STARTTLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ALLOW_INSECURE_AUTH=false
# SMTP_CONNECT_TIMEOUT=5s
# SMTP_SEND_TIMEOUT=30s
# Observability (Phase 7, ADR-0032). Telemetry never blocks or fails startup.
# Tracing: OTLP over HTTP (Jaeger's port 4318), as host:port or an http(s) URL.
# Unset (the default) means tracing is off; set but unreachable means spans are
# dropped and a warning is logged. Inside compose use jaeger:4318 (the jaeger
# service is in the `observability` profile).
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# Standard switch: true turns tracing off even when an endpoint is set.
# OTEL_SDK_DISABLED=false
# service.name; each binary defaults to its own name (course-api, ...).
# OTEL_SERVICE_NAME=
# Head-sampling ratio, 0.0 to 1.0 (1.0 = sample everything, the dev default).
# A span that ends in error is exported regardless (as a fragment of its trace).
# OTEL_TRACES_SAMPLER_ARG=1.0
# Prometheus metrics. The three HTTP services serve GET /metrics on their API
# port; the worker serves it on its own listener, METRICS_HTTP_ADDR (host:port,
# default :9100), NOT on the authenticated admin port. /metrics has no
# authentication by design (Prometheus scrapes it): keep it on a private
# network. Compose publishes the ports on 127.0.0.1 only.
# METRICS_ENABLED=true
# METRICS_HTTP_ADDR=:9100
