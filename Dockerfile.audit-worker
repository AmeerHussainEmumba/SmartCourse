# audit-worker (docs/plans/microservices-split.md §2, §6): the audit-archiver,
# the one consumer of every event topic. Writes the MongoDB archive and
# audit_log and parks its own failures in failed_events. No HTTP API; /metrics
# and the probes are on the internal listener (METRICS_HTTP_ADDR).
# Each service is its own Go module, so this image is built from that module
# plus only the library modules it depends on; nothing else in the repo is
# copied in. Keep the COPY list in step with the module's go.mod `replace`
# directives (scripts/check-dockerfile-modules.sh): GOWORK=off below means a
# missing module fails this build instead of being papered over by go.work.
# The image shares the module with Dockerfile.audit-api.
# Build context is the repo root: docker build -f Dockerfile.audit-worker .
FROM golang:1.26.11-alpine AS build
ENV GOWORK=off CGO_ENABLED=0
WORKDIR /src
COPY libs/auth ./libs/auth
COPY libs/cache ./libs/cache
COPY libs/config ./libs/config
COPY libs/db ./libs/db
COPY libs/errors ./libs/errors
COPY libs/eventbus ./libs/eventbus
COPY libs/events ./libs/events
COPY libs/httpx ./libs/httpx
COPY libs/infra ./libs/infra
COPY libs/kafka ./libs/kafka
COPY libs/logging ./libs/logging
COPY libs/mongostore ./libs/mongostore
COPY libs/outbox ./libs/outbox
COPY libs/relay ./libs/relay
COPY libs/router ./libs/router
COPY libs/runtime ./libs/runtime
COPY libs/telemetry ./libs/telemetry
COPY libs/testenv ./libs/testenv
COPY services/audit ./services/audit
WORKDIR /src/services/audit
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -o /out/audit-worker ./cmd/audit-worker

FROM alpine:3.20
# Run as an unprivileged user: a compromise of the service should not be root in the container.
RUN apk add --no-cache ca-certificates && adduser -D -H -u 10001 app
USER app
COPY --from=build /out/audit-worker /usr/local/bin/audit-worker
ENTRYPOINT ["/usr/local/bin/audit-worker"]
