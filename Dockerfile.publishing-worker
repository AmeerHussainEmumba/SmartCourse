# The publishing worker (docs/plans/microservices-split.md §5): the Temporal
# worker that runs PublishCourseWorkflow and nothing else. No database, no
# Redis, no Kafka; the activities run in the course worker. Each service is its
# own Go module, so this image is built from that module plus only the library
# modules it depends on. Keep the COPY list in step with services/publishing's
# go.mod `replace` directives (scripts/check-dockerfile-modules.sh checks it):
# GOWORK=off below means a missing module fails this build instead of being
# papered over by go.work.
# Build context is the repo root: docker build -f Dockerfile.publishing-worker .
FROM golang:1.26.11-alpine AS build
ENV GOWORK=off CGO_ENABLED=0
WORKDIR /src
COPY libs/auth ./libs/auth
COPY libs/cache ./libs/cache
COPY libs/config ./libs/config
COPY libs/contracts/publishing ./libs/contracts/publishing
COPY libs/db ./libs/db
COPY libs/errors ./libs/errors
COPY libs/httpx ./libs/httpx
COPY libs/infra ./libs/infra
COPY libs/logging ./libs/logging
COPY libs/outbox ./libs/outbox
COPY libs/router ./libs/router
COPY libs/runtime ./libs/runtime
COPY libs/telemetry ./libs/telemetry
COPY libs/temporal ./libs/temporal
COPY libs/testenv ./libs/testenv
COPY services/publishing ./services/publishing
WORKDIR /src/services/publishing
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -o /out/publishing-worker ./cmd/publishing-worker

FROM alpine:3.20
# Run as an unprivileged user: a compromise of the service should not be root in the container.
RUN apk add --no-cache ca-certificates && adduser -D -H -u 10001 app
USER app
COPY --from=build /out/publishing-worker /usr/local/bin/publishing-worker
# The internal listener (/metrics, /health/live, /health/ready); bind it privately.
EXPOSE 9100
ENTRYPOINT ["/usr/local/bin/publishing-worker"]
